# Secrets — never commit
*.token
*.secret
*.key
*.pem
secrets/
config.local.*
**/config.local.*

# Build artifacts
dist/
build/
*.zip
*.apk
*.aab
*.idsig

# Android / Gradle
.gradle/
local.properties

# Evidence can contain SMS metadata, IMEI/IMSI/ICCID/MSISDN, and tokens.
# Ignore the whole dir by default; commit vetted, redacted evidence explicitly
# with `git add -f <file>` after a secret-pattern scan passes.
.omo/evidence/*
!.omo/evidence/.gitkeep

# OS / editor
.DS_Store
*.swp

# built daemon binary shipped in module (build via tools/build-daemon.sh)
magisk/daemon/zflip5-modemd
# stray host build artifact from `go build` inside daemon/ (binary = module name)
daemon/modemd

# built tether helper dex shipped in module (build via tools/build-tether.sh)
magisk/tether/tether.jar

# self-hosted stack secrets + deps
selfhost/bot/.env
selfhost/telegram-bot/.env
selfhost/**/node_modules/
