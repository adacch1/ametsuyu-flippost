# Copy to .env and fill in. NEVER commit .env (it holds secrets).

# --- Telegram ---
# Create a bot with @BotFather (/newbot), paste the token here.
TELEGRAM_TOKEN=
# Comma-separated Telegram chat IDs allowed to control the modem. Message the
# bot once and it replies with your chat id; add it here and restart. Blank =
# the bot runs NO commands (fail-closed) but still tells you your id.
OWNER_CHAT_IDS=

# --- Phone daemon over Tailscale ---
# The phone's `tailscale serve` URL (see docs/telegram-bot.md), or its tailnet
# IP if you exposed the port differently. Loopback-only daemon reached via mesh.
DAEMON_BASE_URL=https://samsung-sm-f731b.tail951eed.ts.net
READ_STATUS=            # daemon read-status token (config.json)
RADIO_CONTROL=          # daemon radio-control token (config.json). NO sms token.

# --- Self-hosted ntfy (optional; alerts also go straight to the owner chat) ---
NTFY_URL=http://ntfy:80 # compose service name; or http://127.0.0.1:8080 with network_mode: host
NTFY_TOPIC=zf5-modem
NTFY_TOKEN=             # ntfy access token (see docs/ntfy.md). Blank if server is open.

# --- Alerts + auto-reboot ---
DATA_CAP_GB=512         # monthly data cap for the "cap near" alert
AUTOREBOOT_HHMM=        # e.g. 04:30 for a daily reboot; blank = off. 24h HH:MM.
# Auto-reboot uses the CONTAINER clock, which is UTC unless you set TZ. To use
# your local time, also set e.g.: TZ=Asia/Ho_Chi_Minh
TZ=
