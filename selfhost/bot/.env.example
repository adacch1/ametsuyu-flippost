# Copy to .env and fill in. NEVER commit .env (it holds secrets).

# --- Discord ---
DISCORD_TOKEN=          # Bot token (Developer Portal -> Bot). Gateway credential.
DISCORD_APP_ID=         # Application ID
DISCORD_GUILD_ID=       # Your server (guild) ID — commands register here instantly
OWNER_USER_IDS=         # Comma-separated Discord user IDs allowed to run /modem
ALERT_CHANNEL_ID=       # Channel ID for mirrored alerts (optional)

# --- Phone daemon over Tailscale ---
# The phone's `tailscale serve` URL (see docs/discord-bot.md), or its tailnet
# IP if you exposed the port differently. Loopback-only daemon reached via mesh.
DAEMON_BASE_URL=https://samsung-sm-f731b.tail951eed.ts.net
READ_STATUS=            # daemon read-status token (config.json)
RADIO_CONTROL=          # daemon radio-control token (config.json). NO sms token.

# --- Self-hosted ntfy ---
NTFY_URL=http://ntfy:80 # compose service name; or http://127.0.0.1:8080 with network_mode: host
NTFY_TOPIC=zf5-modem
NTFY_TOKEN=             # ntfy access token (see README.md §ntfy). Blank if server is open.

# --- Alerts ---
DATA_CAP_GB=512         # monthly data cap for the "cap near" alert (matches the dashboard ring)
