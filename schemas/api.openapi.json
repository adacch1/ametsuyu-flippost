{
 "openapi": "3.1.0",
 "info": {
  "title": "zflip5-modem-module local API",
  "version": "1.0.0",
  "description": "Local-only, loopback-bound, bearer-authenticated control API for a rooted Z Flip 5 used as a modem. Sensitive replies are owner-only. SMS is pull-only, redacted by default, and reachable only over the iPhone/Tailscale path (never a Discord relay). Radio and tether writes are discovery-gated and thermal-gated: 'prefer 5G' means safe prefer/recover NR, never any bypass of thermal mitigation."
 },
 "servers": [
  {
   "url": "http://127.0.0.1:18080",
   "description": "loopback default (api-front)"
  }
 ],
 "components": {
  "securitySchemes": {
   "bearerAuth": {
    "type": "http",
    "scheme": "bearer",
    "description": "Scoped bearer token. Scopes: read-status, sms, radio-control. Tokens are >=256-bit, 0600 under /data/adb, independently revocable."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error",
     "code"
    ],
    "additionalProperties": false,
    "properties": {
     "error": {
      "type": "string"
     },
     "code": {
      "type": "integer"
     },
     "detail": {
      "type": "string"
     }
    }
   },
   "Health": {
    "type": "object",
    "description": "Device host resources (CPU/RAM/temp). Keys mirror tools/collect-metrics.sh.",
    "required": [
     "cpu_load1",
     "cpu_cores",
     "mem_used_pct",
     "temp_battery_c",
     "temp_max_c"
    ],
    "additionalProperties": false,
    "properties": {
     "cpu_load1": {
      "type": "number"
     },
     "cpu_load5": {
      "type": "number"
     },
     "cpu_load15": {
      "type": "number"
     },
     "cpu_cores": {
      "type": "integer",
      "minimum": 1
     },
     "mem_total_kb": {
      "type": "integer",
      "minimum": 0
     },
     "mem_available_kb": {
      "type": "integer",
      "minimum": 0
     },
     "mem_used_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
     },
     "temp_battery_c": {
      "type": "number"
     },
     "temp_max_c": {
      "type": "number"
     },
     "temp_max_zone": {
      "type": "string"
     }
    }
   },
   "Thermal": {
    "type": "object",
    "required": [
     "battery_c",
     "warn_c",
     "safe",
     "source"
    ],
    "additionalProperties": false,
    "properties": {
     "android_status": {
      "type": [
       "string",
       "null"
      ],
      "description": "getCurrentThermalStatus(); advisory only, often NONE on Samsung."
     },
     "battery_c": {
      "type": "number"
     },
     "zones": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "warn_c": {
      "type": "number",
      "const": 44
     },
     "gate_c": {
      "type": "number"
     },
     "temp_max_c": {
      "type": "number",
      "description": "In /v1/status, temp_max_c is the median of the last 7 sysfs sweeps (14 s); temp_max_raw_c is the instantaneous value the gate used. /v1/thermal is always raw."
     },
     "temp_max_raw_c": {
      "type": "number",
      "description": "In /v1/status, temp_max_c is the median of the last 7 sysfs sweeps (14 s); temp_max_raw_c is the instantaneous value the gate used. /v1/thermal is always raw."
     },
     "safe": {
      "type": "boolean",
      "description": "PRIMARY gate: battery temp + /sys/class/thermal. Fails closed."
     },
     "source": {
      "type": "string",
      "enum": [
       "sysfs+battery",
       "android",
       "degraded"
      ]
     }
    }
   },
   "ThermalHistory": {
    "type": "object",
    "description": "Minute/hour/day temperature history, sourced from the same 14 s display median /v1/status serves as temp_max_c -- never the raw safety-gate reading. Every bucket is the sample-weighted mean of the 1-minute samples that fell inside it in device-local time: hour = sum(c)/n over that hour's samples, day = sum(c)/n over that day's samples (never a mean of the hour means, so a partial hour after a restart does not get a full hour's weight). Retention: 24h of minute samples, 7d of hour buckets, 40d of day buckets.",
    "required": [
     "method",
     "minutes",
     "hours",
     "days"
    ],
    "additionalProperties": false,
    "properties": {
     "method": {
      "type": "string",
      "description": "The aggregation method, in prose (see this schema's description)."
     },
     "minutes": {
      "type": "array",
      "description": "[unix_seconds, temp_c] pairs, oldest first, one per recorded minute.",
      "items": {
       "type": "array",
       "prefixItems": [
        { "type": "number", "description": "unix_seconds" },
        { "type": "number", "description": "temp_c" }
       ],
       "minItems": 2,
       "maxItems": 2
      }
     },
     "hours": {
      "type": "array",
      "description": "Hour buckets, ascending by t.",
      "items": { "$ref": "#/components/schemas/ThermalHistoryPoint" }
     },
     "days": {
      "type": "array",
      "description": "Day buckets, ascending by t.",
      "items": { "$ref": "#/components/schemas/ThermalHistoryPoint" }
     }
    }
   },
   "ThermalHistoryPoint": {
    "type": "object",
    "required": ["t", "c", "n"],
    "additionalProperties": false,
    "properties": {
     "t": { "type": "string", "description": "Local hour (\"2006-01-02T15\") or day (\"2006-01-02\") key." },
     "c": { "type": "number", "description": "Sample-weighted mean temp_c for this bucket." },
     "n": { "type": "integer", "description": "Number of minute samples folded into this bucket." }
    }
   },
   "UsageReport": {
    "type": "object",
    "required": [
     "today_bytes",
     "week_bytes",
     "month_bytes",
     "today_human",
     "week_human",
     "month_human",
     "source",
     "period_bytes",
     "period_human",
     "limit_bytes",
     "period",
     "reset_time",
     "reset_day",
     "last_reset",
     "next_reset"
    ],
    "additionalProperties": false,
    "properties": {
     "today_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Mobile bytes used since local midnight today (device-local calendar date)."
     },
     "week_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Mobile bytes used since the start of the current ISO week: Monday 00:00, device-local time."
     },
     "month_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Mobile bytes used since the 1st of the current calendar month, 00:00 device-local time."
     },
     "today_human": {
      "type": "string",
      "description": "today_bytes, formatted in SI decimal units (for example, \"1.23 GB\"). The *_bytes fields are always exact; *_human fields use 1 GB = 10^9 bytes, matching carrier data meters and Android's own data usage screen."
     },
     "week_human": {
      "type": "string",
      "description": "week_bytes, formatted the same way as today_human."
     },
     "month_human": {
      "type": "string",
      "description": "month_bytes, formatted the same way as today_human."
     },
     "source": {
      "type": "string",
      "const": "rmnet-delta",
      "description": "Counters are read from rmnet_data* in /proc/net/dev; a counter reset (reboot) is treated as a fresh delta, never negative."
     },
     "period_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Mobile bytes used since last_reset (manual or scheduled). A meter only — never used to gate the hotspot, radio, or CPU."
     },
     "period_human": {
      "type": "string",
      "description": "period_bytes, formatted the same way as today_human."
     },
     "limit_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Configured data cap in bytes. 0 = no limit configured."
     },
     "period": {
      "type": "string",
      "enum": ["daily", "weekly", "monthly", "manual"],
      "description": "Reset cadence for period_bytes/last_reset."
     },
     "reset_time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Device-local time of day the period resets, HH:MM."
     },
     "reset_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28,
      "description": "Day of month the period resets (monthly only)."
     },
     "last_reset": {
      "type": "string",
      "description": "RFC3339 instant of the last reset (manual or scheduled), or \"\" if never reset."
     },
     "next_reset": {
      "type": "string",
      "description": "RFC3339 instant of the next scheduled reset, or \"\" for a manual period."
     }
    }
   },
   "Status": {
    "type": "object",
    "required": [
     "network",
     "battery",
     "thermal",
     "health",
     "service"
    ],
    "properties": {
     "network": {
      "type": "object"
     },
     "battery": {
      "type": "object"
     },
     "thermal": {
      "$ref": "#/components/schemas/Thermal"
     },
     "health": {
      "$ref": "#/components/schemas/Health"
     },
     "service": {
      "type": "object",
      "required": [
       "daemon",
       "helper"
      ],
      "properties": {
       "daemon": {
        "type": "string"
       },
       "helper": {
        "type": "object",
        "required": [
         "available"
        ],
        "properties": {
         "available": {
          "type": "boolean"
         }
        }
       }
      }
     }
    }
   }
  },
  "responses": {
   "Unauthorized": {
    "description": "missing/invalid token",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "Forbidden": {
    "description": "token lacks the required scope, or non-owner",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "TooManyRequests": {
    "description": "rate limited",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  }
 },
 "security": [
  {
   "bearerAuth": []
  }
 ],
 "paths": {
  "/v1/status": {
   "get": {
    "summary": "Full modem + device-host summary",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Status"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/health": {
   "get": {
    "summary": "Device host CPU/RAM/temperature",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/v1/network": {
   "get": {
    "summary": "Detailed cellular service state (no IMEI/IMSI)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/v1/thermal": {
   "get": {
    "summary": "Thermal gate state (sysfs+battery primary)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Thermal"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/v1/thermal/history": {
   "get": {
    "summary": "Minute/hour/day temperature history (display-path median, never the raw gate)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ThermalHistory"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/battery": {
   "get": {
    "summary": "Battery level/temp/plugged/health",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/v1/sms/recent": {
   "get": {
    "summary": "Recent SMS (pull-only, owner's device, iPhone/Tailscale path only)",
    "description": "Requires the sms scope, or no token when dashboard.open_reads is on. Never exposed to the Discord relay. Bodies are served verbatim on this donor phone; the masking path is compiled off via redactBodies in daemon/sms.go.",
    "security": [
     {
      "bearerAuth": [
       "sms"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "message list"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/notifications/recent": {
   "get": {
    "summary": "Active notification shade (pull-only, owner's device)",
    "description": "Requires the sms scope (same asset class as SMS), or no token when dashboard.open_reads is on. Reads the active shade via root dumpsys; dismissed/history notifications are never returned. Text is verbatim (redactBodies off). Never exposed to the Discord relay.",
    "security": [
     {
      "bearerAuth": [
       "sms"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "notification list"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/tether": {
   "post": {
    "summary": "Start/stop the data hotspot via root helper (?action=start|stop; start is thermal-gated)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "state"
        ],
        "additionalProperties": false,
        "properties": {
         "state": {
          "type": "string",
          "enum": [
           "on",
           "off",
           "status"
          ]
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "applied or current state"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     },
     "409": {
      "description": "refused: thermal gate not safe",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/prefer5g": {
   "post": {
    "summary": "Report current allowed-network-types (NR-preference write not enabled)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "enable"
        ],
        "additionalProperties": false,
        "properties": {
         "enable": {
          "type": "boolean"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "preference applied via cmd phone set-allowed-network-types-for-users"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     },
     "409": {
      "description": "refused: unsafe thermal state",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/cooldown": {
   "post": {
    "summary": "Force an immediate CPU eco pass (reduce-only; works while hot)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "cooldown engaged"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     }
    }
   }
  },
  "/v1/service/restart": {
   "post": {
    "summary": "Restart module daemon/helper only (never the phone)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "restarting"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     }
    }
   }
  },
  "/v1/usage": {
   "get": {
    "summary": "Data-usage report: today, ISO week to date, calendar month to date (device-local time)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/UsageReport"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/usage/quota": {
   "post": {
    "summary": "Set the data-cap limit and/or reset schedule (fields omitted from the body keep their current value)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "limit_bytes": { "type": "integer", "minimum": 0, "description": "Bytes per period. 0 = no limit configured. Omit to keep the current limit; a limit-only edit never touches the period meter." },
         "period": { "type": "string", "enum": ["daily", "weekly", "monthly", "manual"], "description": "Reset cadence. weekly always resets Monday; manual never resets on its own." },
         "reset_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "Device-local time of day the period resets, HH:MM." },
         "reset_day": { "type": "integer", "minimum": 1, "maximum": 28, "description": "Day of month the period resets (monthly only)." }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "full usage report with the updated quota",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/UsageReport"
        }
       }
      }
     },
     "400": {
      "description": "bad body, or an invalid period/reset_time/reset_day/limit_bytes value"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "500": {
      "description": "config.json persist failed; the quota was NOT applied"
     }
    }
   }
  },
  "/v1/usage/reset": {
   "post": {
    "summary": "Manually reset the data-usage period now (period_bytes -> 0, last_reset -> now); today/week/month are untouched",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "full usage report, freshly reset",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/UsageReport"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/signal": {
   "get": {
    "summary": "Detailed LTE/5G signal snapshot (NSA-aware tech, band, RSRP/RSRQ/SINR)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/clients": {
   "get": {
    "summary": "Connected hotspot clients (IP + reachability state)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/bands": {
   "get": {
    "summary": "Allowed radio band/type report (read-only)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/cpu": {
   "get": {
    "summary": "CPU power/perf policy state + per-core telemetry",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/hotspot": {
   "get": {
    "summary": "Hotspot state + SSID-whitelist auto-toggle status (paused/paused_detail when scanning can't run, override_until/override_left_s while a timed force-on is active)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/hotspot/whitelist": {
   "post": {
    "summary": "Replace the SSID whitelist (empty disables auto-toggle)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "updated whitelist + status",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "400": {
      "description": "invalid ssids"
     }
    }
   }
  },
  "/v1/hotspot/override": {
   "post": {
    "summary": "Force the hotspot on for N hours regardless of whitelist matches, then revert (0 cancels); a policy write like the whitelist, not thermal-gated",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "hours"
        ],
        "additionalProperties": false,
        "properties": {
         "hours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24,
          "description": "0 cancels an active override"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "hotspot status, with override_until/override_left_s set while forced on",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "400": {
      "description": "hours outside 0..24"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/thermal/limits": {
   "post": {
    "summary": "Retune warn_c/gate_c (server-clamped; gate ceiling 48C)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "effective (possibly clamped) limits",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "400": {
      "description": "non-finite values"
     }
    }
   }
  },
  "/v1/airplane": {
   "post": {
    "summary": "Airplane on/off or IP-rotation cycle (body {\"mode\":\"on|off|cycle\"}); serialized, 409 if busy",
