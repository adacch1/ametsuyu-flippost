{
 "openapi": "3.1.0",
 "info": {
  "title": "zflip5-modem-module local API",
  "version": "1.0.0",
  "description": "Local-only, loopback-bound, bearer-authenticated control API for a rooted Z Flip 5 used as a modem. Sensitive replies are owner-only. Radio and tether writes are discovery-gated and thermal-gated: they never bypass thermal mitigation."
 },
 "servers": [
  {
   "url": "http://127.0.0.1:18080",
   "description": "loopback default (api-front)"
  }
 ],
 "components": {
  "securitySchemes": {
   "bearerAuth": {
    "type": "http",
    "scheme": "bearer",
    "description": "Scoped bearer token. Scopes: read-status, radio-control. Tokens are >=256-bit, 0600 under /data/adb, independently revocable."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error",
     "code"
    ],
    "additionalProperties": false,
    "properties": {
     "error": {
      "type": "string"
     },
     "code": {
      "type": "integer"
     },
     "detail": {
      "type": "string"
     },
     "reason": {
      "type": "string",
      "description": "machine-readable token on every 409 and every app-only 403"
     }
    }
   },
   "Health": {
    "type": "object",
    "description": "Device host resources (CPU/RAM/temp). Keys mirror tools/collect-metrics.sh.",
    "required": [
     "cpu_load1",
     "cpu_cores",
     "mem_used_pct",
     "temp_battery_c",
     "temp_max_c"
    ],
    "additionalProperties": false,
    "properties": {
     "cpu_load1": {
      "type": "number"
     },
     "cpu_load5": {
      "type": "number"
     },
     "cpu_load15": {
      "type": "number"
     },
     "cpu_cores": {
      "type": "integer",
      "minimum": 1
     },
     "mem_total_kb": {
      "type": "integer",
      "minimum": 0
     },
     "mem_available_kb": {
      "type": "integer",
      "minimum": 0
     },
     "mem_used_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
     },
     "temp_battery_c": {
      "type": "number"
     },
     "temp_max_c": {
      "type": "number"
     },
     "temp_max_zone": {
      "type": "string"
     }
    }
   },
   "Thermal": {
    "type": "object",
    "required": [
     "battery_c",
     "warn_c",
     "safe",
     "source"
    ],
    "additionalProperties": false,
    "properties": {
     "android_status": {
      "type": [
       "string",
       "null"
      ],
      "description": "getCurrentThermalStatus(); advisory only, often NONE on Samsung."
     },
     "battery_c": {
      "type": "number"
     },
     "zones": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "warn_c": {
      "type": "number",
      "const": 44
     },
     "gate_c": {
      "type": "number"
     },
     "temp_max_c": {
      "type": "number",
      "description": "In /v1/status, temp_max_c is the median of the last 5 sysfs sweeps (25 s); temp_max_raw_c is the instantaneous value the gate used. /v1/thermal is always raw."
     },
     "temp_max_raw_c": {
      "type": "number",
      "description": "In /v1/status, temp_max_c is the median of the last 5 sysfs sweeps (25 s); temp_max_raw_c is the instantaneous value the gate used. /v1/thermal is always raw."
     },
     "safe": {
      "type": "boolean",
      "description": "PRIMARY gate: battery temp + /sys/class/thermal. Fails closed."
     },
     "source": {
      "type": "string",
      "enum": [
       "sysfs+battery",
       "android",
       "degraded"
      ]
     }
    }
   },
   "UsageReport": {
    "type": "object",
    "required": [
     "today_bytes",
     "week_bytes",
     "month_bytes",
     "today_human",
     "week_human",
     "month_human",
     "source",
     "period_bytes",
     "period_human",
     "limit_bytes",
     "period",
     "reset_time",
     "reset_day",
     "last_reset",
     "next_reset"
    ],
    "additionalProperties": false,
    "properties": {
     "today_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Mobile bytes used since local midnight today (device-local calendar date)."
     },
     "week_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Mobile bytes used since the start of the current ISO week: Monday 00:00, device-local time."
     },
     "month_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Mobile bytes used since the 1st of the current calendar month, 00:00 device-local time."
     },
     "today_human": {
      "type": "string",
      "description": "today_bytes, formatted in SI decimal units (for example, \"1.23 GB\"). The *_bytes fields are always exact; *_human fields use 1 GB = 10^9 bytes, matching carrier data meters and Android's own data usage screen."
     },
     "week_human": {
      "type": "string",
      "description": "week_bytes, formatted the same way as today_human."
     },
     "month_human": {
      "type": "string",
      "description": "month_bytes, formatted the same way as today_human."
     },
     "source": {
      "type": "string",
      "const": "rmnet-delta",
      "description": "Counters are read from rmnet_data* in /proc/net/dev; a counter reset (reboot) is treated as a fresh delta, never negative."
     },
     "period_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Mobile bytes used since last_reset (manual or scheduled). A meter only — never used to gate the hotspot, radio, or CPU."
     },
     "period_human": {
      "type": "string",
      "description": "period_bytes, formatted the same way as today_human."
     },
     "limit_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Configured data cap in bytes. 0 = no limit configured."
     },
     "period": {
      "type": "string",
      "enum": [
       "daily",
       "weekly",
       "monthly",
       "manual"
      ],
      "description": "Reset cadence for period_bytes/last_reset."
     },
     "reset_time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Device-local time of day the period resets, HH:MM."
     },
     "reset_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28,
      "description": "Day of month the period resets (monthly only)."
     },
     "last_reset": {
      "type": "string",
      "description": "RFC3339 instant of the last reset (manual or scheduled), or \"\" if never reset."
     },
     "next_reset": {
      "type": "string",
      "description": "RFC3339 instant of the next scheduled reset, or \"\" for a manual period."
     }
    }
   },
   "Status": {
    "type": "object",
    "required": [
     "network",
     "battery",
     "thermal",
     "health",
     "service"
    ],
    "properties": {
     "network": {
      "type": "object"
     },
     "battery": {
      "type": "object"
     },
     "thermal": {
      "$ref": "#/components/schemas/Thermal"
     },
     "health": {
      "$ref": "#/components/schemas/Health"
     },
     "service": {
      "type": "object",
      "required": [
       "daemon",
       "helper"
      ],
      "properties": {
       "daemon": {
        "type": "string"
       },
       "helper": {
        "type": "object",
        "required": [
         "available"
        ],
        "properties": {
         "available": {
          "type": "boolean"
         }
        }
       }
      }
     }
    }
   }
  },
  "responses": {
   "Unauthorized": {
    "description": "missing/invalid token",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "Forbidden": {
    "description": "token lacks the required scope, or non-owner",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "TooManyRequests": {
    "description": "rate limited",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  }
 },
 "security": [
  {
   "bearerAuth": []
  }
 ],
 "paths": {
  "/v1/status": {
   "get": {
    "summary": "Full modem + device-host summary",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Status"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/thermal": {
   "get": {
    "summary": "Thermal gate state (sysfs+battery primary)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Thermal"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/v1/battery": {
   "get": {
    "summary": "Battery level/temp/plugged/health",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/v1/tether": {
   "post": {
    "summary": "Start/stop the data hotspot via root helper (?action=start|stop; start is thermal-gated)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "state"
        ],
        "additionalProperties": false,
        "properties": {
         "state": {
          "type": "string",
          "enum": [
           "on",
           "off",
           "status"
          ]
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "applied or current state"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     },
     "409": {
      "description": "refused: thermal gate not safe",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/cooldown": {
   "post": {
    "summary": "Force an immediate CPU eco pass (reduce-only; works while hot)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "cooldown engaged"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     }
    }
   }
  },
  "/v1/service/restart": {
   "post": {
    "summary": "Restart module daemon/helper only (never the phone)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "restarting"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     }
    }
   }
  },
  "/v1/usage": {
   "get": {
    "summary": "Data-usage report: today, ISO week to date, calendar month to date (device-local time)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/UsageReport"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/usage/quota": {
   "post": {
    "summary": "Set the data-cap limit and/or reset schedule (fields omitted from the body keep their current value)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "limit_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes per period. 0 = no limit configured. Omit to keep the current limit; a limit-only edit never touches the period meter."
         },
         "period": {
          "type": "string",
          "enum": [
           "daily",
           "weekly",
           "monthly",
           "manual"
          ],
          "description": "Reset cadence. weekly always resets Monday; manual never resets on its own."
         },
         "reset_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Device-local time of day the period resets, HH:MM."
         },
         "reset_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28,
          "description": "Day of month the period resets (monthly only)."
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "full usage report with the updated quota",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/UsageReport"
        }
       }
      }
     },
     "400": {
      "description": "bad body, or an invalid period/reset_time/reset_day/limit_bytes value"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "500": {
      "description": "config.json persist failed; the quota was NOT applied"
     }
    }
   }
  },
  "/v1/usage/reset": {
   "post": {
    "summary": "Manually reset the data-usage period now (period_bytes -> 0, last_reset -> now); today/week/month are untouched",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "full usage report, freshly reset",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/UsageReport"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/signal": {
   "get": {
    "summary": "Detailed LTE/5G signal snapshot (NSA-aware tech, band, RSRP/RSRQ/SINR)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/clients": {
   "get": {
    "summary": "Connected hotspot clients (IP + reachability state)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/cpu": {
   "get": {
    "summary": "CPU power/perf policy state + per-core telemetry",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/hotspot": {
   "get": {
    "summary": "Hotspot state + SSID-whitelist auto-toggle status (paused/paused_detail when scanning can't run, override_until/override_left_s while a timed force-on is active)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/hotspot/whitelist": {
   "post": {
    "summary": "Replace the SSID whitelist (empty disables auto-toggle)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "updated whitelist + status",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "400": {
      "description": "invalid ssids"
     },
     "409": {
      "description": "reason dual_band: turn off dual band first",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/hotspot/override": {
   "post": {
    "summary": "Force the hotspot on for N hours regardless of whitelist matches, then revert (0 cancels); a policy write like the whitelist, not thermal-gated",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "hours"
        ],
        "additionalProperties": false,
        "properties": {
         "hours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24,
          "description": "0 cancels an active override"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "hotspot status, with override_until/override_left_s set while forced on",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "400": {
      "description": "hours outside 0..24"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/thermal/limits": {
   "post": {
    "summary": "Retune warn_c/gate_c (server-clamped; gate ceiling 48C)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "effective (possibly clamped) limits",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "400": {
      "description": "non-finite values"
     }
    }
   }
  },
  "/v1/airplane": {
   "post": {
    "summary": "Airplane on/off or IP-rotation cycle (body {\"mode\":\"on|off|cycle\"}); serialized, 409 if busy",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "airplane state / rotate result",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "409": {
      "description": "reason busy: an airplane operation is already in progress",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/device/reboot": {
   "post": {
    "summary": "Reboot the whole phone; module restores daemon+hotspot on boot",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "rebooting",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/summary": {
   "get": {
    "summary": "Everything the app home, widget and web main view need in one call, served from memory (slow_age_s above 30 means the collector is stuck)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "summary v1",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/tailscale": {
   "get": {
    "summary": "Tailscale status from the LocalAPI (3 s timeout, always 200; never returns keys or a login URL)",
    "security": [
     {
      "bearerAuth": [
       "read-status"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "state, ips, dns_name, serve_ok, web_url and more",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     }
    }
   }
  },
  "/v1/tailscale/login": {
   "post": {
    "summary": "Start an interactive Tailscale login (app UID only)",
    "responses": {
     "200": {
      "description": "state plus login_url, or state running with login_url null",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "403": {
      "description": "app_only",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "reason needs_machine_auth or busy",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "502": {
      "description": "reason localapi",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "reason not_running",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "504": {
      "description": "reason no_login_url",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/tailscale/logout": {
   "post": {
    "summary": "Log Tailscale out after saving prefs (app UID only)",
    "responses": {
     "200": {
      "description": "state needs_login",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "403": {
      "description": "app_only",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "502": {
      "description": "reason localapi",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "reason not_running",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/hotspot/dual": {
   "post": {
    "summary": "Turn bridged dual band on or off (body {\"enabled\":bool,\"apply_now\":bool}, apply_now defaults to false)",
    "security": [
     {
      "bearerAuth": [
       "radio-control"
      ]
     }
    ],
    "responses": {
     "200": {
      "description": "dual_band, applied (now or next_start) and hotspot status",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "400": {
      "description": "bad body"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     },
     "409": {
      "description": "reason busy, whitelist or auto_switch; disabling is never blocked",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "502": {
      "description": "reason helper",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "enabled": {
          "type": "boolean"
         },
         "apply_now": {
          "type": "boolean",
          "default": false
         }
        },
        "required": [
         "enabled"
        ]
       }
      }
     }
    }
   }
  }
 }
}